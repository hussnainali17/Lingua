# Stream keys — copied automatically from the parent repo's .env at runtime.
# Add these here only if you want to override the parent values.
# STREAM_API_KEY=your_stream_api_key
# STREAM_API_SECRET=your_stream_api_secret

# Gemini API key — required for the Realtime voice model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
